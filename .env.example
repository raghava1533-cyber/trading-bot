# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to core/.env and fill in real values
# NEVER commit core/.env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstox API Credentials ────────────────────────────────────────────────────
# Get API Key + Secret from: https://developer.upstox.com/ -> Your Apps
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_secret_key_here

# Redirect URI — must match exactly what you set in the developer portal
UPSTOX_REDIRECT_URI=https://127.0.0.1

# Auth code — paste here after browser login, then run: python core/broker/auth.py
# This is a one-time code (expires in minutes). auth.py clears it after use.
UPSTOX_AUTH_CODE=paste_auth_code_here

# Access token — auto-filled by broker/auth.py. Do not edit manually.
# Expires at 3:30 AM next day. Run auth.py each morning before starting bot.
UPSTOX_ACCESS_TOKEN=

# ── Active Indices ────────────────────────────────────────────────────────────
ACTIVE_INDICES=NIFTY,BANKNIFTY,SENSEX

# ── Strategy Params ───────────────────────────────────────────────────────────
STOP_LOSS=-1500
TARGET_PROFIT=1000
TARGET_DELTA=0.30
SPREAD_WIDTH_POINTS=200
DEFAULT_IV=0.18

# ── Risk / Execution ──────────────────────────────────────────────────────────
RISK_FREE_RATE=0.06
MIN_TIME_TO_EXPIRY_DAYS=1
POLL_INTERVAL_SECONDS=60
TRADE_COOLDOWN_SECONDS=900
MAX_TRADES_PER_DAY=3
DRY_RUN=true

# ── Market Hours (IST, 24h HH:MM) ────────────────────────────────────────────
MARKET_OPEN_TIME=09:20
MARKET_CLOSE_TIME=15:15

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=models/xgb.pkl
MODEL_MAX_AGE_DAYS=7

# ── Regime Thresholds (calibrated to NIFTY daily vol) ────────────────────────
REGIME_LOW_VOL=0.007
REGIME_HIGH_VOL=0.011

# ── Backtest ──────────────────────────────────────────────────────────────────
BACKTEST_INITIAL_CAPITAL=500000
BACKTEST_DAYS=365
BACKTEST_ENTRY_EVERY_BARS=5
BACKTEST_HOLDING_BARS=10
BACKTEST_COMMISSION_PER_ORDER=20
BACKTEST_SLIPPAGE_BPS=2
BACKTEST_STRIKE_STEP=50
BACKTEST_CHAIN_WIDTH_POINTS=1000
BACKTEST_STOP_LOSS=-1500
BACKTEST_TARGET_PROFIT=1000
BACKTEST_OUTPUT_DIR=backtest_results
BACKTEST_OPTION_DATA_PATH=
BACKTEST_ALLOW_SYNTHETIC_FALLBACK=true

# ── Instrument Cache ──────────────────────────────────────────────────────────
INSTRUMENT_CACHE_FILE=instruments_cache.json
INSTRUMENT_CACHE_TTL_HOURS=12

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=trading_bot.log

# ── API Server ────────────────────────────────────────────────────────────────
BOT_ENABLED=true
FRONTEND_URL=*
