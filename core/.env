# NEVER commit real credentials to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstox API Credentials ───────────────────────────────────────────────────
# Step 1: Get API Key + Secret from https://developer.upstox.com/
UPSTOX_API_KEY=0db8ba78-7ddc-4019-804c-553573a0bd7c
UPSTOX_API_SECRET=0hiqrlitbm

# Step 2: Set your redirect URI (must match what you set in developer portal)
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/upstox/callback


# Step 4: Access token is auto-generated from auth code and saved here
#   (broker/auth.py fills this automatically — do not edit manually)
UPSTOX_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiI2NDEwNjAiLCJqdGkiOiI2YTNkNzRiNjIwYTVjODA0NjM0N2ZmMGUiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6ZmFsc2UsImlhdCI6MTc4MjQxMjQ3MCwiaXNzIjoidWRhcGktZ2F0ZXdheS1zZXJ2aWNlIiwiZXhwIjoxNzgyNDI0ODAwfQ.4NVUoMWOGmB_y5FMIQ8NlL7RJzBxOCgKS3Q0B7sgbuk

# ── Active Indices ────────────────────────────────────────────────────────────
ACTIVE_INDICES=NIFTY,BANKNIFTY,SENSEX

# ── Strategy Params ───────────────────────────────────────────────────────────
STOP_LOSS=-1500
TARGET_PROFIT=1000
TARGET_DELTA=0.30
SPREAD_WIDTH_POINTS=200
DEFAULT_IV=0.18

# ── Risk / Execution ──────────────────────────────────────────────────────────
RISK_FREE_RATE=0.06
MIN_TIME_TO_EXPIRY_DAYS=1
POLL_INTERVAL_SECONDS=60
TRADE_COOLDOWN_SECONDS=900
MAX_TRADES_PER_DAY=3
DRY_RUN=true

# ── Market Hours (IST, 24h HH:MM) ────────────────────────────────────────────
MARKET_OPEN_TIME=09:20
MARKET_CLOSE_TIME=15:15

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=models/xgb.pkl
MODEL_MAX_AGE_DAYS=7

# ── Regime Thresholds (calibrated to NIFTY daily vol) ────────────────────────
REGIME_LOW_VOL=0.005
REGIME_HIGH_VOL=0.008
REGIME_SIDE_VOL_THRESHOLD=0.005

# ── Backtest ──────────────────────────────────────────────────────────────────
BACKTEST_INITIAL_CAPITAL=500000
BACKTEST_DAYS=365
BACKTEST_ENTRY_EVERY_BARS=5
BACKTEST_HOLDING_BARS=10
BACKTEST_COMMISSION_PER_ORDER=20
BACKTEST_SLIPPAGE_BPS=2
BACKTEST_STRIKE_STEP=50
BACKTEST_CHAIN_WIDTH_POINTS=1000
BACKTEST_STOP_LOSS=-1500
BACKTEST_TARGET_PROFIT=1000
BACKTEST_OUTPUT_DIR=backtest_results
BACKTEST_OPTION_DATA_PATH=
BACKTEST_ALLOW_SYNTHETIC_FALLBACK=true

# ── Instrument Cache ──────────────────────────────────────────────────────────
INSTRUMENT_CACHE_FILE=instruments_cache.json
INSTRUMENT_CACHE_TTL_HOURS=12

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=trading_bot.log

# ── API Server ────────────────────────────────────────────────────────────────
BOT_ENABLED=true
FRONTEND_URL=*
